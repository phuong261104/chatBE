# LiveKit API credentials. These must match the `keys` section
# in the selected LiveKit config file and the backend .env file.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_WS_URL=ws://localhost:7880

# Local defaults:
LIVEKIT_CONFIG_FILE=config.local.yml
LIVEKIT_NODE_IP=127.0.0.1

# Production example:
# LIVEKIT_CONFIG_FILE=config.prod.yml
# LIVEKIT_NODE_IP=<public-server-ip>
# LIVEKIT_WS_URL=wss://call.example.com
