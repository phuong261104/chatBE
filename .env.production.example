# ============================================================================
# BACKEND PRODUCTION DOCKER ENV
# Production runs fully self-hosted data services on one VPS.
# Gemini and LiveKit remain external. Copy to `.env.production` and fill secrets.
# ============================================================================

NODE_ENV=production
PORT=3000
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Create a remotely-managed tunnel in Cloudflare Zero Trust, then copy only
# its token here. Never commit the real token.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
CLOUDFLARED_CONTAINER_NAME=chatbe-cloudflared

# Docker host port for backend. Use reverse proxy in front when possible.
BACKEND_PORT=3000
BACKEND_IMAGE=chatbe-backend:prod
BACKEND_CONTAINER_NAME=chatbe-backend-prod

# ============================================================================
# DYNAMODB LOCAL
# ============================================================================
DYNAMODB_IMAGE=amazon/dynamodb-local:latest
DYNAMODB_CONTAINER_NAME=chatbe-dynamodb-local
DYNAMODB_REGION=local
DYNAMODB_ENDPOINT=http://dynamodb-local:8000
DYNAMODB_TABLE_PREFIX=chatbe_

# ============================================================================
# REDIS SAME-SERVER DOCKER SERVICE
# ============================================================================
REDIS_IMAGE=redis:7-alpine
REDIS_CONTAINER_NAME=chatbe-redis-prod
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# JWT
# ============================================================================
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_PASSWORD_RESET_SECRET=
JWT_PASSWORD_RESET_EXPIRES_IN=1h

# ============================================================================
# APP SETTINGS
# ============================================================================
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_REFRESH_COOKIE_ENABLED=true
AUTH_REFRESH_COOKIE_NAME=chatbe_refresh_token
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_SECURE=true
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_DESTINATION=./uploads
UPLOAD_BASE_URL=https://api.example.com/uploads
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/mpeg,video/quicktime,audio/mpeg,audio/wav,application/pdf

# ============================================================================
# MINIO / AI / LIVEKIT
# ============================================================================
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
MINIO_CONTAINER_NAME=chatbe-minio
MINIO_INIT_CONTAINER_NAME=chatbe-minio-init
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_CORS_ALLOW_ORIGIN=https://app.example.com

CLOUD_STORAGE_ENABLED=true
CLOUD_STORAGE_PROVIDER=minio
CLOUD_BUCKET_NAME=chatbe-media
CLOUD_REGION=us-east-1
CLOUD_ENDPOINT=http://minio:9000
CLOUD_PUBLIC_ENDPOINT=https://storage.example.com
CLOUD_PUBLIC_BASE_URL=https://storage.example.com/chatbe-media
CLOUD_FORCE_PATH_STYLE=true
CLOUD_ACCESS_KEY_ID=
CLOUD_SECRET_ACCESS_KEY=

DEMO_PASSWORD=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://call.example.com
LIVEKIT_CLOUD_API_KEY=
LIVEKIT_CLOUD_API_SECRET=
LIVEKIT_CLOUD_WS_URL=wss://your-project.livekit.cloud

# ============================================================================
# RATE LIMITER
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW=900
