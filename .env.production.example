# ============================================================================
# BACKEND PRODUCTION DOCKER ENV
# Production uses the same image/command as local, AWS DynamoDB, and same-server Redis.
# Copy to `.env.production` on the server and fill secrets there.
# ============================================================================

NODE_ENV=production
PORT=3000
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com

# Docker host port for backend. Use reverse proxy in front when possible.
BACKEND_PORT=3000
BACKEND_IMAGE=chatbe-backend:prod
BACKEND_CONTAINER_NAME=chatbe-backend-prod

# ============================================================================
# AWS DYNAMODB
# Leave endpoint empty to use AWS DynamoDB, not DynamoDB Local.
# ============================================================================
DYNAMODB_REGION=ap-southeast-1
DYNAMODB_ENDPOINT=
DYNAMODB_TABLE_PREFIX=chatbe_
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================================
# REDIS SAME-SERVER DOCKER SERVICE
# ============================================================================
REDIS_IMAGE=redis:7-alpine
REDIS_CONTAINER_NAME=chatbe-redis-prod
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# JWT
# ============================================================================
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_PASSWORD_RESET_SECRET=
JWT_PASSWORD_RESET_EXPIRES_IN=1h

# ============================================================================
# APP SETTINGS
# ============================================================================
AUTH_REQUIRE_EMAIL_VERIFICATION=true
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_DESTINATION=./uploads
UPLOAD_BASE_URL=https://api.example.com/uploads
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/mpeg,video/quicktime,audio/mpeg,audio/wav,application/pdf

# ============================================================================
# CLOUD STORAGE / AI / LIVEKIT
# ============================================================================
CLOUD_STORAGE_ENABLED=false
CLOUD_STORAGE_PROVIDER=aws
CLOUD_BUCKET_NAME=
CLOUD_REGION=
CLOUD_ACCESS_KEY_ID=
CLOUD_SECRET_ACCESS_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://call.example.com
LIVEKIT_CLOUD_API_KEY=
LIVEKIT_CLOUD_API_SECRET=
LIVEKIT_CLOUD_WS_URL=wss://your-project.livekit.cloud
