# ChatBE Production Environment Variables
# Copy this file to {{ app_dir }}/.env.production and fill in your values
# DO NOT commit this file to version control

# Application
NODE_ENV=production
PORT={{ backend_port }}

# AWS DynamoDB
AWS_REGION=your-aws-region
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_PREFIX=chatbe_

# Redis
REDIS_HOST=redis
REDIS_PORT={{ redis_port }}
REDIS_PASSWORD=your-redis-password

# JWT
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars

# JWT expiration (in seconds)
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# Session
SESSION_SECRET=your-session-secret

# Email / SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com

# AWS S3 / Storage
AWS_S3_BUCKET=your-s3-bucket
AWS_S3_REGION=your-s3-region

# LiveKit
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-livekit-server

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# JWT Blacklist TTL (in seconds)
JWT_BLACKLIST_TTL=604800
