services:
  backend:
    image: {{ image_name }}
    container_name: {{ backend_container_name }}
    restart: always
    ports:
      - "{{ backend_port }}:{{ backend_port }}"
    env_file:
      - {{ app_dir }}/{{ backend_env_file }}
    volumes:
      - {{ volumes.uploads }}:/app/uploads
      - {{ volumes.logs }}:/app/logs
    healthcheck:
      test: >
        node -e "require('http').get('http://127.0.0.1:{{ backend_port }}{{ backend_healthcheck_path }}',
        r => process.exit(r.statusCode < 500 ? 0 : 1)).on('error', () => process.exit(1))"
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    networks:
      - {{ network_name }}
    depends_on:
      redis:
        condition: service_healthy

  redis:
    image: redis:7-alpine
    container_name: {{ redis_container_name }}
    restart: always
    ports:
      - "{{ redis_port }}:{{ redis_port }}"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 3
    networks:
      - {{ network_name }}

networks:
  {{ network_name }}:
    name: {{ network_name }}
    driver: bridge

volumes:
  {{ volumes.uploads }}:
    name: {{ volumes.uploads }}
  {{ volumes.logs }}:
    name: {{ volumes.logs }}
