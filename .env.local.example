# ============================================================================
# BACKEND LOCAL DOCKER ENV
# Local still uses AWS DynamoDB. Redis runs in the same Docker stack.
# Copy to `.env.local` and fill secrets locally.
# ============================================================================

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Docker host port for backend. Used by compose interpolation.
BACKEND_PORT=3000
BACKEND_IMAGE=chatbe-backend:local
BACKEND_CONTAINER_NAME=chatbe-backend-local

# ============================================================================
# AWS DYNAMODB
# Leave endpoint empty to use AWS DynamoDB, not DynamoDB Local.
# ============================================================================
DYNAMODB_REGION=ap-southeast-1
DYNAMODB_ENDPOINT=
DYNAMODB_TABLE_PREFIX=chatbe_dev_
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================================
# REDIS SAME-SERVER DOCKER SERVICE
# ============================================================================
REDIS_IMAGE=redis:7-alpine
REDIS_CONTAINER_NAME=chatbe-redis-local
REDIS_HOST_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# JWT
# ============================================================================
JWT_ACCESS_SECRET=change-me-local-access-secret-min-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-local-refresh-secret-min-32chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_PASSWORD_RESET_SECRET=change-me-local-reset-secret
JWT_PASSWORD_RESET_EXPIRES_IN=1h

# ============================================================================
# APP SETTINGS
# ============================================================================
AUTH_REQUIRE_EMAIL_VERIFICATION=false
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_DESTINATION=./uploads
UPLOAD_BASE_URL=http://localhost:3000/uploads
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/mpeg,video/quicktime,audio/mpeg,audio/wav,application/pdf

# ============================================================================
# CLOUD STORAGE / AI / LIVEKIT
# ============================================================================
CLOUD_STORAGE_ENABLED=false
CLOUD_STORAGE_PROVIDER=aws
CLOUD_BUCKET_NAME=
CLOUD_REGION=
CLOUD_ACCESS_KEY_ID=
CLOUD_SECRET_ACCESS_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_CLOUD_API_KEY=
LIVEKIT_CLOUD_API_SECRET=
LIVEKIT_CLOUD_WS_URL=
