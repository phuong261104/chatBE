# ============================================================================
# BACKEND LOCAL DOCKER ENV
# Local Docker runs DynamoDB Local, Redis, and MinIO without AWS credentials.
# Copy to `.env.local` and fill secrets locally.
# ============================================================================

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Docker host port for backend. Used by compose interpolation.
BACKEND_PORT=3000
BACKEND_IMAGE=chatbe-backend:local
BACKEND_CONTAINER_NAME=chatbe-backend-local

# ============================================================================
# DYNAMODB LOCAL
# ============================================================================
DYNAMODB_REGION=local
DYNAMODB_ENDPOINT=http://dynamodb-local:8000
DYNAMODB_TABLE_PREFIX=chatbe_dev_
DYNAMODB_IMAGE=amazon/dynamodb-local:latest

# ============================================================================
# REDIS SAME-SERVER DOCKER SERVICE
# ============================================================================
REDIS_IMAGE=redis:7-alpine
REDIS_CONTAINER_NAME=chatbe-redis-local
REDIS_HOST_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# JWT
# ============================================================================
JWT_ACCESS_SECRET=change-me-local-access-secret-min-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-local-refresh-secret-min-32chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_PASSWORD_RESET_SECRET=change-me-local-reset-secret
JWT_PASSWORD_RESET_EXPIRES_IN=1h

# ============================================================================
# APP SETTINGS
# ============================================================================
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_REFRESH_COOKIE_ENABLED=true
AUTH_REFRESH_COOKIE_NAME=chatbe_refresh_token
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_SECURE=false
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_DESTINATION=./uploads
UPLOAD_BASE_URL=http://localhost:3000/uploads
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/mpeg,video/quicktime,audio/mpeg,audio/wav,application/pdf

# ============================================================================
# CLOUD STORAGE / AI / LIVEKIT
# ============================================================================
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-local-minio-password
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:5173

CLOUD_STORAGE_ENABLED=true
CLOUD_STORAGE_PROVIDER=minio
CLOUD_BUCKET_NAME=chatbe-media
CLOUD_REGION=us-east-1
CLOUD_ENDPOINT=http://minio:9000
CLOUD_PUBLIC_ENDPOINT=http://localhost:9000
CLOUD_PUBLIC_BASE_URL=http://localhost:9000/chatbe-media
CLOUD_FORCE_PATH_STYLE=true
CLOUD_ACCESS_KEY_ID=chatbe-local
CLOUD_SECRET_ACCESS_KEY=change-me-local-app-secret

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_CLOUD_API_KEY=
LIVEKIT_CLOUD_API_SECRET=
LIVEKIT_CLOUD_WS_URL=

# ============================================================================
# RATE LIMITER
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW=900
