{
  "info": {
    "_postman_id": "a7d6a97f-4baa-4ef9-b033-c6c31c8f0d2f",
    "name": "chatBE - Full API Collection",
    "description": "Collection test full REST API for chatBE.\n\nBase URL mac dinh: {{baseUrl}}\nSau khi login thanh cong, token se tu dong luu vao bien {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "targetUserId",
      "value": ""
    },
    {
      "key": "blockedUserId",
      "value": ""
    },
    {
      "key": "receiverId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "friendId",
      "value": ""
    },
    {
      "key": "conversationId",
      "value": ""
    },
    {
      "key": "groupId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    },
    {
      "key": "anyUserId",
      "value": ""
    },
    {
      "key": "mediaFilename",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth & User",
      "item": [
        {
          "name": "Auth - Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"user@example.com\",\"password\":\"123456\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "response": []
        },
        {
          "name": "Auth - Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "const token = json?.data?.token || json?.data?.accessToken || json?.token;",
                  "if (token) { pm.collectionVariables.set('token', token); }",
                  "const userId = json?.data?.user?.id || json?.data?.userId;",
                  "if (userId) { pm.collectionVariables.set('userId', userId); }"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"user@example.com\",\"password\":\"123456\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "response": []
        },
        {
          "name": "User - Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/profile"
          },
          "response": []
        },
        {
          "name": "User - Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"displayName\":\"Updated Name\",\"avatarUrl\":\"https://example.com/avatar.jpg\",\"bio\":\"Hello world\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/profile"
          },
          "response": []
        },
        {
          "name": "User - Create (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"new-user@example.com\",\"password\":\"123456\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/users"
          },
          "response": []
        },
        {
          "name": "User - List",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/users?page=1&limit=20"
          },
          "response": []
