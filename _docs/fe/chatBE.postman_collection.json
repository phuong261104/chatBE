        {
          "name": "User - Update (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"displayName\":\"Updated By Admin\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/users/{{anyUserId}}"
          },
          "response": []
        },
        {
          "name": "User - Delete (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/{{anyUserId}}"
          },
          "response": []
        },
        {
          "name": "RPC - Introspect",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"token\":\"{{token}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/rpc/introspect"
          },
          "response": []
        }
      ]
    },
    {
