# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Choose database type: "mongodb" or "dynamodb"
# Default: mongodb (existing MongoDB)
DB_TYPE=mongodb

# MongoDB Configuration (used when DB_TYPE=mongodb)
MONGO_URI=mongodb://localhost:27018/express_ts_app
MONGODB_DB_NAME=express_ts_app

# DynamoDB Configuration (used when DB_TYPE=dynamodb)
# Local DynamoDB: Use docker-compose dynamodb-local container
DYNAMODB_REGION=localhost
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_PREFIX=chatbe_

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=redis://localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
JWT_ACCESS_SECRET=access-secret-key-change-in-production-min-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=refresh-secret-key-change-in-production-min-32chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_PASSWORD_RESET_SECRET=reset-secret-key-change-in-production
JWT_PASSWORD_RESET_EXPIRES_IN=1h

# ============================================================================
# EMAIL CONFIGURATION (SMTP)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@chatbe.io
EMAIL_FROM_NAME=ChatBE

# ============================================================================
# APP CONFIGURATION
# ============================================================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ============================================================================
# AUTH CONFIGURATION
# ============================================================================
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_DESTINATION=./uploads
UPLOAD_BASE_URL=http://localhost:3000/uploads
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/mpeg,video/quicktime,audio/mpeg,audio/wav,application/pdf

# ============================================================================
# CLOUD STORAGE (AWS S3 / Cloudflare R2 / etc.)
# ============================================================================
CLOUD_STORAGE_ENABLED=false
CLOUD_STORAGE_PROVIDER=aws
CLOUD_BUCKET_NAME=
CLOUD_REGION=
CLOUD_ACCESS_KEY_ID=
CLOUD_SECRET_ACCESS_KEY=

# ============================================================================
# RPC (Microservices)
# ============================================================================
RPC_PRODUCT_BRAND_URL=http://localhost:3000
RPC_PRODUCT_CATEGORY_URL=http://localhost:3000
